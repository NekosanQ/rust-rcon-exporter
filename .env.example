# Copy to .env for Docker Compose. Keep the real file out of Git.
# Single-quote passwords to preserve literal $, # and spaces. Escape ' as \'.
# The Python application itself does not automatically load this file.
RCON_PASSWORD='replace-with-your-rcon-password'
RCON_HOST=127.0.0.1
RCON_PORT=28016
RCON_POLL_INTERVAL=5
METRICS_PORT=9187
